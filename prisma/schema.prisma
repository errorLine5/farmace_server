// database
datasource db {
  provider = "sqlite"
  url      = "file:database_orm.db"
}

// generator
generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

model Pharmacy {
  id          String   @id
  nome_farmacia String
  indirizzo   String
  lat         Float
  lng         Float
  orari       String   // JSON string for opening hours
  turni       String   // JSON string for shifts
  numeri      String
  sito_web    String
  image       String?
  items       Item[]   // Relation to items
  workers     Worker[] // Relation to workers
  stocks      Stock[]  // Relation to stocks
}

model Stock {
  id          String   @id
  id_item     String
  quantity    Int
  price       Float
  pharmacy    Pharmacy @relation(fields: [id_pharmacy], references: [id], onDelete: Cascade, onUpdate: Cascade)
  id_pharmacy String
  item        Item     @relation(fields: [id_item], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Item {
  id              String   @id
  item_name       String
  description_item String
  price           Float
  category        String   @default("OTHER")
  image           String?
  pharmacy        Pharmacy @relation(fields: [id_pharmacy], references: [id], onDelete: Cascade, onUpdate: Cascade)
  id_pharmacy     String
  stocks          Stock[]  // Add this line
}

model User {
  id              String    @id
  first_name      String
  last_name       String
  email           String    @unique
  username        String    @unique
  password        String
  phone_number    String
  picture         String
  verified        Boolean   @default(false)
  can_own         Boolean   @default(false)
  email_token     String?
  sessions        Session[] // Relation to sessions
  workers         Worker[]  // Relation to workers
}

model Worker {
  id          String   @id
  permission  Int
  pharmacy    Pharmacy @relation(fields: [id_pharmacy], references: [id])
  id_pharmacy String
  user        User     @relation(fields: [id_user], references: [id])
  id_user     String
}


model Session {
  id          String   @id @default(uuid())
  token       String   @unique
  token_expiration DateTime?
  created_at DateTime @default(now())
  user        User     @relation(fields: [id_user], references: [id])
  id_user     String
}